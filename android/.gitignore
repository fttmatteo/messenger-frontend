# Usando la plantilla de gitignore para Android: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Archivos de la aplicación compilados
*.apk
*.aar
*.ap_
*.aab

# Archivos para la VM ART/Dalvik
*.dex

# Archivos de clases de Java
*.class

# Archivos generados
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# Directorio de plugins externos nativos generado en Android Studio 2.2 y posteriores
.externalNativeBuild
.cxx/

# Servicios de Google (ej. APIs o Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Control de versiones
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Perfilado de Android
*.hprof

# Plugins de Cordova para Capacitor
capacitor-cordova-android-plugins

# Assets web copiados
app/src/main/assets/public

# Archivos de configuración generados
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
app/src/main/res/xml/config.xml
