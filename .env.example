# ===========================================
# MESSENGER FRONTEND - Environment Template
# ===========================================
# Copiar este archivo a .env y completar los valores
# IMPORTANTE: Nunca subir el archivo .env al repositorio

# Backend API URL
VITE_API_URL=http://localhost:8080

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google Maps Map ID
VITE_GOOGLE_MAPS_MAP_ID=tu_map_id_aqui

# Cloudflare Turnstile (Anti-Bot Verification)
# Obtener en: https://dash.cloudflare.com → Turnstile
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
