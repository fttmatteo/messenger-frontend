# ============================================
# MESSENGER FRONTEND - Environment Variables
# ============================================
# Este es el archivo de ejemplo. Copia según el entorno:
# - Para desarrollo local: .env.development
# - Para staging: .env.staging  
# - Para producción: .env.production

# =============
# API Backend
# =============
# URL completa del backend (incluir protocolo http:// o https://)
# Desarrollo: http://localhost:8080
# Staging: https://messenger-backend-staging-xxx.run.app
# Producción: https://messenger-backend-190705671004.us-central1.run.app
VITE_API_URL=http://localhost:8080

# =============
# Google Maps
# =============
# API Key para Google Maps (geocodificación y mapas)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =================
# App Information
# =================
# Información de la PWA (usada en manifest.json)
VITE_APP_NAME=PLAK Messenger
VITE_APP_DESCRIPTION=Sistema de gestión de mensajería

# =============
# Environment
# =============
# Modo de la aplicación (development, staging, production)
# Vite establece esto automáticamente, pero se puede sobrescribir
# VITE_MODE=development
