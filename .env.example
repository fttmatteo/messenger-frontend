# ===========================================
# MESSENGER FRONTEND - Environment Variables
# ===========================================
# Copia este archivo a .env y ajusta los valores

# Backend API URL (para producción)
# En desarrollo, el proxy de vite.config.ts redirige /api a localhost:8080
VITE_API_URL=http://localhost:8080

# Información de la aplicación (opcional, usado en PWA)
VITE_APP_NAME=Messenger
VITE_APP_DESCRIPTION=Sistema de gestión de mensajería
