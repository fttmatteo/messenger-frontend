# ===========================================
# MESSENGER FRONTEND - Environment Template
# ===========================================
# Copiar este archivo a .env y completar los valores

# Backend API URL
VITE_API_URL=http://localhost:8080

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google Maps Map ID (Opcional - usa DEMO_MAP_ID si se omite)
# Tipo: JavaScript (Vector)
VITE_GOOGLE_MAPS_MAP_ID=tu_map_id_aqui

# App Info
VITE_APP_NAME=PLAK Messenger
VITE_APP_DESCRIPTION=Sistema de gestión de mensajería

# Support Contact
VITE_SUPPORT_EMAIL=soporte@plak.digital
