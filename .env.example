# ===========================================
# MESSENGER FRONTEND - Environment Variables
# ===========================================
# Este es un archivo de ejemplo. Copia este archivo como .env y configura los valores reales.

# Backend API URL
# Desarrollo: http://localhost:8080
# Producción: URL de tu backend desplegado
VITE_API_URL=http://localhost:8080

# Google Maps API Key
# Obtener en: https://console.cloud.google.com/apis/credentials
# 
# Pasos para crear y configurar:
# 1. Crear una nueva API Key en Google Cloud Console
# 2. Habilitar las siguientes APIs:
#    - Maps JavaScript API
#    - Geocoding API
# 3. Configurar restricciones de seguridad:
#    - Application restrictions: HTTP referrers (websites)
#    - Website restrictions:
#      * localhost:* (desarrollo)
#      * tu-dominio.com/* (producción)
#    - API restrictions: Solo las APIs mencionadas arriba
# 
# ⚠️ IMPORTANTE: Nunca subir el archivo .env al repositorio
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Información de la aplicación (opcional, usado en PWA)
VITE_APP_NAME=PLAK Messenger
VITE_APP_DESCRIPTION=Sistema de gestión de mensajería
